# Copy to `.env.development.local`, `.env.dev.local`, or `.env.qa.local` for secrets.
# Committed env files use placeholders only — do not put real API keys here.

# --- Cognito (Amplify `aws-exports`) ---
VITE_AWS_USER_POOLS_ID=eu-west-1_XXXXXXXXX
VITE_AWS_USER_POOLS_WEB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- AppSync / Amplify GraphQL ---
VITE_APPSYNC_URL=https://your-appsync-id.appsync-api.eu-west-1.amazonaws.com/graphql
VITE_APPSYNC_API_KEY=
VITE_APPSYNC_REGION=eu-west-1

# --- API Gateway bases ---
VITE_API_BASE=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/dev
VITE_FLIGHT_API_BASE=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/dev
VITE_PAYMENT_API_BASE=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/qa
VITE_FLIGHT_ANCILLARY_API_BASE=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/qa
VITE_HOTEL_API_BASE=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/qa
VITE_LOCATION_API_BASE=https://countriesnow.space/api/v0.1
VITE_TICKET_API_BASE=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/dev
VITE_HOTEL_FAVOURITE_API_BASE=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/qa
VITE_FLIGHT_CANCELLATION_API_BASE=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/qa

VITE_GUEST_REST_API_BASE=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/dev
VITE_USER_SVC_BASE_URL=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com
VITE_GUEST_TOKEN_API_URL=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/qa/guest-token

# PayFort
VITE_PAYFORT_PAYMENT_PAGE_URL=https://sbcheckout.payfort.com/FortAPI/paymentPage
VITE_PAYFORT_TOKEN_RETURN_URL=
VITE_PAYFORT_ACCESS_CODE=
VITE_PAYFORT_MERCHANT_IDENTIFIER=
VITE_PAYFORT_SHA_REQUEST_PHRASE=
VITE_PAYFORT_SHA_RESPONSE_PHRASE=

VITE_S3_TICKET_PUBLIC_BASE=https://your-bucket.s3.eu-west-1.amazonaws.com

